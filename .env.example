# ============================================================
# SmartAttend AI — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# ----- Application -----
APP_NAME=SmartAttend AI
APP_VERSION=1.0.0
DEBUG=false
SECRET_KEY=your-very-long-random-secret-key-change-this-in-production

# ----- MongoDB -----
# Leave empty to run with built-in zero-config JSON database (no MongoDB needed)
MONGODB_URI=
DATABASE_NAME=smartattend_db

# ----- Force JSON Fallback (useful for testing without MongoDB) -----
FORCE_JSON_DB=false

# ----- JWT Authentication -----
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----- CORS -----
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ----- AI Engine Thresholds -----
RECOGNITION_THRESHOLD=0.982
ANTI_SPOOFING_THRESHOLD=0.65
FACE_QUALITY_THRESHOLD=0.60

# ----- Camera Settings -----
CAMERA_INDEX=0
FRAME_WIDTH=640
FRAME_HEIGHT=480
TARGET_FPS=20

# ----- Email Notifications (SMTP) -----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=noreply@smartattend.ai

# ----- Attendance Rules -----
LATE_ENTRY_MINUTES=15
MIN_ATTENDANCE_PERCENTAGE=75

# ----- Security -----
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30
